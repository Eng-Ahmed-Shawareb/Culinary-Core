    SELECT JOIN: TableView shows
    supplier name alongside batch.
    ComboBox populated via
    SupplierService.
  end note

  class ConsumeController {
    - tableView      : TableView<Consume>
    - cmbBatch       : ComboBox<IngredientBatch>
    - cmbWorkshop    : ComboBox<Workshop>
    - txtQuantity    : TextField
    - dtpConsumeDate : DatePicker
    - btnLog         : Button
    - btnUpdate      : Button
    - btnRemove      : Button
    - btnClear       : Button
    --
    + initialize()      : void
    + loadData()        : void
    + clearForm()       : void
    + onLog_Click()     : void
    + onUpdate_Click()  : void
    + onRemove_Click()  : void
    + onRowSelect()     : void
  }

  note right of ConsumeController
    <b><color:#0550AE>CRUD</color></b>
    INSERT: log batch usage in workshop.
    UPDATE: correct quantity consumed.
    DELETE: remove incorrect log.
    SELECT JOIN: TableView shows batch
    name + workshop title + kitchen.
  end note

