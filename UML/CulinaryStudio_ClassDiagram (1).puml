  class IngredientBatchController {
    - tableView   : TableView<IngredientBatch>
    - txtID       : TextField
    - txtName     : TextField
    - txtUnits    : TextField
    - cmbSupplier : ComboBox<Supplier>
    - dtpDelivery : DatePicker
