    - txtLastName  : TextField
    - cmbGender    : ComboBox<String>
    - txtPhone     : TextField
    - btnAdd       : Button
    - btnUpdate    : Button
    - btnDelete    : Button
    - btnClear     : Button
    --
    + initialize()      : void
    + loadData()        : void
    + clearForm()       : void
    + onAdd_Click()     : void
    + onUpdate_Click()  : void
    + onDelete_Click()  : void
    + onRowSelect()     : void
