  class SupplierController {
    - tableView : TableView<Supplier>
    - txtID     : TextField
    - txtName   : TextField
    - btnAdd    : Button
    - btnUpdate : Button
    - btnDelete : Button
    - btnClear  : Button
    --
    + initialize()      : void
    + loadData()        : void
    + clearForm()       : void
    + onAdd_Click()     : void
    + onUpdate_Click()  : void
    + onDelete_Click()  : void
