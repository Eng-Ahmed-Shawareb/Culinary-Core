<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="768.0" prefWidth="774.0" spacing="20.0" styleClass="main-content" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.culinarycore.gui.DashboardController">
    <children>
        <Label styleClass="header-label" text="Dashboard" />
        <Label styleClass="subtitle-label" text="Select an inquiry to view reports and analytics." />
        
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <ComboBox fx:id="cmbInquiry" prefWidth="400.0" promptText="Select Inquiry" styleClass="combo-box" />
                <Button fx:id="btnRun" mnemonicParsing="false" onAction="#onRun_Click" styleClass="button-primary" text="Run Inquiry" />
            </children>
        </HBox>
        
        <Label fx:id="lblTitle" text="Results" />
        <Label fx:id="lblSubtitle" styleClass="subtitle-label" text="" />
        
        <HBox VBox.vgrow="ALWAYS" spacing="20.0">
            <children>
                <TableView fx:id="tableView" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
            </children>
        </HBox>
    </children>
</VBox>
