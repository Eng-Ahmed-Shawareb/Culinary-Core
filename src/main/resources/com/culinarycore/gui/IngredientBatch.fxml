<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="768.0" prefWidth="774.0" spacing="20.0" styleClass="main-content" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.culinarycore.gui.IngredientBatchController">
    <children>
        <Label styleClass="header-label" text="Ingredient Batch Management" />
        <Label styleClass="subtitle-label" text="Manage supplier deliveries and expiration dates." />
        
        <GridPane hgap="15.0" styleClass="form-grid" vgap="15.0">
            <children>

                
                <Label styleClass="form-label" text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtName" promptText="Batch Name" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                
                <Label styleClass="form-label" text="Units:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtUnits" promptText="0" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                
                <Label styleClass="form-label" text="Supplier:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <ComboBox fx:id="cmbSupplier" prefWidth="200.0" promptText="Select Supplier" styleClass="combo-box" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                
                <Label styleClass="form-label" text="Delivery Date:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <DatePicker fx:id="dtpDelivery" promptText="Date" styleClass="date-picker" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                
                <Label styleClass="form-label" text="Expiration Date:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                <DatePicker fx:id="dtpExpiry" promptText="Date" styleClass="date-picker" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                
                <Label styleClass="form-label" text="State:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <ComboBox fx:id="cmbState" prefWidth="200.0" promptText="Select State" styleClass="combo-box" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </children>
        </GridPane>
        
        <HBox spacing="10.0">
            <children>
                <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#onAdd_Click" styleClass="button-primary" text="Add Batch" />
                <Button fx:id="btnUpdate" mnemonicParsing="false" onAction="#onUpdate_Click" styleClass="button-secondary" text="Update" />
                <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#onDelete_Click" styleClass="button-danger" text="Delete" />
                <Button fx:id="btnClear" mnemonicParsing="false" onAction="#clearForm" styleClass="button-secondary" text="Clear Form" />
            </children>
        </HBox>
        
        <TableView fx:id="tableView" onMouseClicked="#onRowSelect" prefHeight="300.0" maxWidth="Infinity" VBox.vgrow="ALWAYS" />
    </children>
</VBox>
