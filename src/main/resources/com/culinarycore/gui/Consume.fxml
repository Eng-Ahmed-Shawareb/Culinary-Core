<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="768.0" prefWidth="774.0" spacing="20.0" styleClass="main-content" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.culinarycore.gui.ConsumeController">
    <children>
        <Label styleClass="header-label" text="Batch Consumption" />
        <Label styleClass="subtitle-label" text="Log ingredient usage during workshops." />
        
        <GridPane hgap="15.0" styleClass="form-grid" vgap="15.0">
            <children>
                <Label styleClass="form-label" text="Ingredient Batch:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <ComboBox fx:id="cmbBatch" prefWidth="250.0" promptText="Select Batch" styleClass="combo-box" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                
                <Label styleClass="form-label" text="Workshop:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <ComboBox fx:id="cmbWorkshop" prefWidth="250.0" promptText="Select Workshop" styleClass="combo-box" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                
                <Label styleClass="form-label" text="Quantity Used:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtQuantity" promptText="0" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                
                <Label styleClass="form-label" text="Consume Date:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <DatePicker fx:id="dtpConsumeDate" promptText="Date" styleClass="date-picker" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            </children>
        </GridPane>
        
        <HBox spacing="10.0">
            <children>
                <Button fx:id="btnLog" mnemonicParsing="false" onAction="#onLog_Click" styleClass="button-primary" text="Log Consumption" />
                <Button fx:id="btnUpdate" mnemonicParsing="false" onAction="#onUpdate_Click" styleClass="button-secondary" text="Update" />
                <Button fx:id="btnRemove" mnemonicParsing="false" onAction="#onRemove_Click" styleClass="button-danger" text="Remove Log" />
                <Button fx:id="btnClear" mnemonicParsing="false" onAction="#clearForm" styleClass="button-secondary" text="Clear Form" />
            </children>
        </HBox>
        
        <TableView fx:id="tableView" onMouseClicked="#onRowSelect" prefHeight="300.0" maxWidth="Infinity" VBox.vgrow="ALWAYS" />
    </children>
</VBox>
