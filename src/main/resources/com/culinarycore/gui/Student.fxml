<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="768.0" prefWidth="774.0" spacing="20.0" styleClass="main-content" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.culinarycore.gui.StudentController">
    <children>
        <Label styleClass="header-label" text="Student Management" />
        <Label styleClass="subtitle-label" text="Manage student profiles." />
        
        <GridPane hgap="15.0" styleClass="form-grid" vgap="15.0">
            <children>
                <Label styleClass="form-label" text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtID" disable="true" editable="false" promptText="Auto-generated" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                
                <Label styleClass="form-label" text="First Name:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <TextField fx:id="txtFirstName" promptText="First Name" styleClass="text-field" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                
                <Label styleClass="form-label" text="Last Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtLastName" promptText="Last Name" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                
                <Label styleClass="form-label" text="Gender:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <ComboBox fx:id="cmbGender" prefWidth="200.0" promptText="Select Gender" styleClass="combo-box" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                
                <Label styleClass="form-label" text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="txtPhone" promptText="Phone Number" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
        </GridPane>
        
        <HBox spacing="10.0">
            <children>
                <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#onAdd_Click" styleClass="button-primary" text="Add Student" />
                <Button fx:id="btnUpdate" mnemonicParsing="false" onAction="#onUpdate_Click" styleClass="button-secondary" text="Update" />
                <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#onDelete_Click" styleClass="button-danger" text="Delete" />
                <Button fx:id="btnClear" mnemonicParsing="false" onAction="#clearForm" styleClass="button-secondary" text="Clear Form" />
            </children>
        </HBox>
        
        <TableView fx:id="tableView" onMouseClicked="#onRowSelect" prefHeight="300.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
    </children>
</VBox>
